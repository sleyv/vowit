# .env.example
# Rename this file to .env and fill in your values.

# ---------------------------------------------------------
# Required Settings
# ---------------------------------------------------------

# Your Groq API Key. Get it from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_api_key_here

# ---------------------------------------------------------
# Daemon & UI Settings
# ---------------------------------------------------------

# Enable debug logging for the daemon.
# Variants: true, false
# Default: false
DEBUG=false

# Language for desktop notifications (e.g., recording status, errors).
# Variants: en, ru
# Default: en
UI_LANGUAGE=en

# ---------------------------------------------------------
# Transcription Settings (Groq Whisper)
# ---------------------------------------------------------

# The Whisper model used for audio transcription.
# Variants: whisper-large-v3, whisper-large-v3-turbo, distil-whisper-large-v3-en
# Default: whisper-large-v3
WHISPER_MODEL=whisper-large-v3

# The language spoken in the audio. ISO-639-1 code (e.g., ru, en, es, fr, de).
# This helps the Whisper model transcribe faster and more accurately.
# Default: ru
BOT_LANGUAGE=ru

# Whether to pass context between separate rapid recordings.
# If true and a new recording starts within 15 seconds, the previous sentence is passed to Whisper.
# Default: true
KEEP_CONTEXT_BETWEEN_RECORDINGS=true

# ---------------------------------------------------------
# Audio Processing Settings
# ---------------------------------------------------------

# VAD (Voice Activity Detection) threshold for silence detection.
# Lower = more sensitive (catches quieter speech). Range: 0.0-1.0
# Default: 0.5
VAD_THRESHOLD=0.5

# Minimum silence duration (ms) before VAD considers speech ended.
# Higher = longer pauses allowed before splitting. Default: 200
VAD_MIN_SILENCE_MS=200

# How many seconds of continuous speech before dispatching a chunk to the API.
# Higher = fewer API calls but longer wait for partial results. Default: 15.0
CHUNK_SPEECH_SECONDS=15.0

# ---------------------------------------------------------
# UI & Behaviour Settings
# ---------------------------------------------------------

# Time window (seconds) for detecting multi-press patterns.
# 1 press = clipboard, 2 presses = paste, 3 presses = system audio.
# Default: 0.6
MULTI_PRESS_WINDOW=0.6

# Cooldown after stopping a recording (ignores accidental presses). Default: 2.0
STOP_COOLDOWN=1.0

# Auto-stop recording after this many seconds (safety limit). Default: 600 (10 min)
RECORDING_TIMEOUT=600

# How long the result notification stays visible (seconds). Default: 4
NOTIFICATION_DURATION=4

# Sound volume (0.0 = silent, 1.0 = original). Default: 0.8
SOUND_VOLUME=0.8
# Sound playback speed multiplier (1.0 = normal, 2.0 = 2x). Default: 1.0
SOUND_SPEED=1.0

# Delay between paste (Ctrl+Shift+V) and Enter keypress (seconds). Default: 0.2
PASTE_ENTER_DELAY=0.2

# ---------------------------------------------------------
# LLM "Fix text" Settings (Groq Chat Completions)
# ---------------------------------------------------------

# The LLM model used when the 'fixon' toggle is used to fix grammar and punctuation.
# Variants:
#   - llama-3.3-70b-versatile (Great overall model for text)
#   - gemma2-9b-it (Fast and lightweight)
#   - mixtral-8x7b-32768 (Good alternative)
#   - openai/gpt-oss-120b (Custom alias you specifically requested)
# Default: openai/gpt-oss-120b
LLM_MODEL=openai/gpt-oss-120b

# The base URL endpoint for the Chat Completions API.
# If you use Groq, keep the default. If you use OpenRouter or another OpenAI-compatible provider
# to access specific models like 'openai/gpt-oss-120b', change this URL.
# Variants:
#   - https://api.groq.com/openai/v1/chat/completions (Groq)
#   - https://openrouter.ai/api/v1/chat/completions (OpenRouter)
# Default: https://api.groq.com/openai/v1/chat/completions
LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
